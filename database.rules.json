{
  "rules": {
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && ((data.exists() && newData.child('role').val() === data.child('role').val()) || (!data.exists() && root.child('settings/allowedAdminUids').child($uid).exists() && newData.child('role').val() === 'admin'))) || root.child('admins').child(auth.uid).child('role').val() === 'owner')"
      }
    },
    "audit": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "allowedAdminUids": {
        ".write": "auth != null && root.child('admins').child(auth.uid).child('role').val() === 'owner'"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
