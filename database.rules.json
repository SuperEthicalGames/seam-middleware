{
  "rules": {
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (data.exists() || root.child('settings/allowedAdminUids').child($uid).exists())"
      }
    },
    "audit": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["timestamp"]
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "allowedAdminUids": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
