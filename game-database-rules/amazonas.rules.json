{
  "rules": {
    "identificators": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "serials": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "users": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "owners": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    "admins": {
      ".read": "auth != null && root.child('owners').child(auth.uid).val() === true",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('owners').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('owners').child(auth.uid).val() === true",
        ".validate": "newData.val() === true"
      }
    },

    "adminRequests": {
      ".read": "auth != null && root.child('owners').child(auth.uid).val() === true",

      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('owners').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('owners').child(auth.uid).val() === true || (auth.uid === $uid && !data.exists()))",
        ".validate": "newData.hasChildren(['email', 'requestedAt']) && newData.child('email').isString() && newData.child('email').val() === auth.token.email && newData.child('requestedAt').isNumber()",
        "email": {},
        "requestedAt": {},
        "$other": { ".validate": false }
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
